    adjust_rain_entity: ""
  show_name: true
  show_icon: true
  show_state: true
  color_type: icon
  icon: mdi:weather-pouring
  name: >
    [[[
      if (entity.state === 'on') {
        if (variables.adjust_rain_entity && hass.states[variables.adjust_rain_entity]?.state === 'on')
          return 'Piove - Irrigazione Bloccata';
        return 'Piove - Blocco Ignorato';
      }
      return 'Sensore Pioggia - OK';
    ]]]
