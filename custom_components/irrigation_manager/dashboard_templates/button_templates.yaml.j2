          [[[
            if (entity.state === 'on') return 'rgba(33, 150, 243, 0.1)';
            return '';
          ]]]
    icon:
      - height: 30px
      - color: >-
          [[[
            if (!entity || !entity.state) return 'grey';
            if (entity.state === 'on') return '#2196f3';
            return 'grey';
          ]]]
      - justify-self: start
    name:
      - justify-self: start
    grid:
      - grid-template-areas: '"i n s"'
      - grid-template-rows: auto
      - grid-template-columns: "15% 65% 20%"

