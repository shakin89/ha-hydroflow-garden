{# Rendered by hydroflow_garden/dashboard.py into the storage dashboard. #}

type: grid
cards:
  - type: heading
    heading: "Programmi"
    heading_style: title
{%- for p in ctrl.programs %}
  {%- set pn = "p" ~ p.id %}
  {%- set eid_prefix = "iu_" ~ ctrl.id ~ "_" ~ pn %}
  # === Programma {{ p.id }}: {{ p.name }} ===
  - type: custom:button-card
    template: iu_program_header
    entity: switch.{{ eid_prefix }}_enabled
    # sequence_status del controller cambia a ogni start/stop/pausa di sequence
    triggers_update:
      - binary_sensor.irrigation_unlimited_c{{ ctrl.iu_index + 1 }}_m
    variables:
      name: "P{{ p.id }} {{ p.name }}"
      controller_entity: binary_sensor.irrigation_unlimited_c{{ ctrl.iu_index + 1 }}_m
      sequence_base: binary_sensor.irrigation_unlimited_c{{ ctrl.iu_index + 1 }}_s
      program_prefix: "P{{ p.id }} "
      day_prefix: switch.{{ eid_prefix }}
      zone_ids: [{{ ctrl.zones | map(attribute='id') | join(', ') }}]

  - type: conditional
    conditions:
      - condition: state
        entity: switch.{{ eid_prefix }}_enabled
        state: "on"
    card:
      type: vertical-stack
      cards:
      - type: heading
        heading: Orario
        icon: mdi:clock-outline
      - type: horizontal-stack
        cards:
          - type: entities
            entities:
              - entity: select.{{ eid_prefix }}_time_type
                name: ""
                title: Tipo di orario
            grid_options:
              columns: 6
              rows: 1
          - type: conditional
            conditions:
              - condition: state
                entity: select.{{ eid_prefix }}_time_type
                state: "Fisso"
            card:
              type: entities
              entities:
                - entity: time.{{ eid_prefix }}_time
                  name: "P{{ p.id }}"
                  show_icon: false
            grid_options:
              columns: 6
              rows: 1
          - type: conditional
            conditions:
              - condition: state
                entity: select.{{ eid_prefix }}_time_type
                state_not: "Fisso"
            card:
              type: tile
              grid_options:
                columns: 6
                rows: 1
              entity: number.{{ eid_prefix }}_offset
              name: Offset
              show_entity_picture: false
              hide_state: false
              state_content: state
              vertical: false
              features:
                - style: slider
                  type: numeric-input
              features_position: bottom

      - type: heading
        heading: "Mesi dell'anno"
        icon: mdi:calendar-month-outline
      - type: horizontal-stack
        cards:
        {%- for m_code, _, m_short in months[:6] %}
          - type: custom:button-card
            template: iu_month_toggle
            entity: switch.{{ eid_prefix }}_{{ m_code }}
            name: "{{ m_short }}"
        {%- endfor %}
        grid_options:
          columns: 12
      - type: horizontal-stack
        cards:
        {%- for m_code, _, m_short in months[6:] %}
          - type: custom:button-card
            template: iu_month_toggle
            entity: switch.{{ eid_prefix }}_{{ m_code }}
            name: "{{ m_short }}"
        {%- endfor %}
        grid_options:
          columns: 12

      - type: heading
        heading: "Modalità ECO"
        icon: mdi:sprout-outline
      - type: custom:button-card
        template: iu_eco_toggle
        entity: switch.{{ eid_prefix }}_eco
        variables:
          cycles_entity: number.{{ eid_prefix }}_eco_cycles
          soak_entity: number.{{ eid_prefix }}_eco_soak
        grid_options:
          columns: 12

      - type: heading
        heading: "Programmi"
        icon: mdi:calendar-multiple-check
      {%- for z in ctrl.zones %}
      - type: custom:button-card
        template: iu_zone_row
        entity: switch.{{ eid_prefix }}_z{{ z.id }}_enabled
        variables:
          zone_name: "Z{{ z.id }} {{ z.name }}"
          duration_entity: number.{{ eid_prefix }}_z{{ z.id }}_duration
          duration_adjusted: sensor.{{ ('IU ' ~ ctrl.name ~ ' Z' ~ z.id ~ ' ' ~ z.name ~ ' Programmato') | slugify }}
          day_mon: switch.{{ eid_prefix }}_z{{ z.id }}_mon
          day_tue: switch.{{ eid_prefix }}_z{{ z.id }}_tue
          day_wed: switch.{{ eid_prefix }}_z{{ z.id }}_wed
          day_thu: switch.{{ eid_prefix }}_z{{ z.id }}_thu
          day_fri: switch.{{ eid_prefix }}_z{{ z.id }}_fri
          day_sat: switch.{{ eid_prefix }}_z{{ z.id }}_sat
          day_sun: switch.{{ eid_prefix }}_z{{ z.id }}_sun
          zone_entity: binary_sensor.irrigation_unlimited_c{{ ctrl.iu_index + 1 }}_z{{ z.id }}
      {%- endfor %}

{% endfor %}
